---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { Image } from 'astro:assets';

type Props = CollectionEntry<'blog'>['data'] & { lang?: string };

const { title, description, pubDate, updatedDate, heroImage, lang = 'ru' } = Astro.props;
const isEn = lang === 'en';
const backLink = isEn ? '/en/blog' : '/blog';
const backLabel = isEn ? '← Blog' : '← Блог';
const doneLabel = isEn ? 'Done' : 'Готово';
const updatedLabel = isEn ? 'Updated:' : 'Обновлено:';
---

<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<div class="article-window">
				<div class="window-titlebar">
					<span>📄 {title}</span>
					<div class="window-buttons">
						<span class="win-btn">_</span>
						<span class="win-btn">□</span>
						<span class="win-btn">✕</span>
					</div>
				</div>

				<div class="window-menubar">
					<a href={backLink} class="menu-item menu-back">{backLabel}</a>
					<span class="menu-item">Файл</span>
					<span class="menu-item">Правка</span>
					<span class="menu-item">Вид</span>
				</div>

				<div class="window-content">
					{heroImage && (
						<div class="hero-image-wrap">
							<Image src={heroImage} alt={title} class="hero-img" width={720} height={300} />
						</div>
					)}
					<div class="article-meta">
						<span class="article-date"><FormattedDate date={pubDate} /></span>
						{updatedDate && (
							<span class="article-updated">{updatedLabel} <FormattedDate date={updatedDate} /></span>
						)}
					</div>
					<div class="prose">
						<slot />
					</div>
				</div>

				<div class="window-statusbar">
					<span>{doneLabel}</span>
					<span class="status-sep">|</span>
					<span><FormattedDate date={pubDate} /></span>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 760px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 1em;
	}
	.article-window {
		background: rgb(var(--gray));
		border-top: 2px solid rgb(var(--win95-highlight));
		border-left: 2px solid rgb(var(--win95-highlight));
		border-right: 2px solid rgb(var(--win95-shadow));
		border-bottom: 2px solid rgb(var(--win95-shadow));
	}
	.window-titlebar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		background: linear-gradient(to right, #0000aa, #1084d7);
		color: white;
		padding: 3px 6px;
		font-size: 12px;
		font-weight: bold;
		font-family: "MS Sans Serif", Arial, sans-serif;
		user-select: none;
	}
	.window-buttons { display: flex; gap: 2px; flex-shrink: 0; }
	.win-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 16px;
		height: 14px;
		background: rgb(var(--gray));
		color: black;
		font-size: 9px;
		font-weight: bold;
		border-top: 1px solid rgb(var(--win95-highlight));
		border-left: 1px solid rgb(var(--win95-highlight));
		border-right: 1px solid rgb(var(--win95-shadow));
		border-bottom: 1px solid rgb(var(--win95-shadow));
		cursor: default;
		font-family: "MS Sans Serif", Arial, sans-serif;
	}
	.window-menubar {
		display: flex;
		gap: 0;
		padding: 2px 4px;
		border-bottom: 1px solid rgb(var(--win95-shadow));
		background: rgb(var(--gray));
	}
	.menu-item {
		padding: 2px 8px;
		font-size: 11px;
		font-family: "MS Sans Serif", Arial, sans-serif;
		color: black;
		text-decoration: none;
		cursor: default;
	}
	.menu-back {
		text-decoration: underline;
		color: #0000aa;
		cursor: pointer;
	}
	.menu-back:hover, .menu-item:not(.menu-back):hover {
		background: #0000aa;
		color: white;
	}
	.window-content {
		background: white;
		margin: 4px;
		border-top: 1px solid rgb(var(--win95-shadow));
		border-left: 1px solid rgb(var(--win95-shadow));
		border-right: 1px solid rgb(var(--win95-highlight));
		border-bottom: 1px solid rgb(var(--win95-highlight));
		padding: 16px 20px;
		min-height: 300px;
	}
	.hero-image-wrap { margin: -16px -20px 16px -20px; }
	.hero-img {
		width: 100%;
		height: 240px;
		object-fit: cover;
		display: block;
		border-radius: 0;
		border-bottom: 1px solid rgb(var(--win95-shadow));
	}
	.article-meta {
		display: flex;
		gap: 12px;
		font-size: 11px;
		color: rgb(var(--gray-dark));
		font-family: "MS Sans Serif", Arial, sans-serif;
		margin-bottom: 12px;
		padding-bottom: 8px;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.article-updated { font-style: italic; }
	.prose {
		font-family: "MS Sans Serif", Arial, sans-serif;
		font-size: 13px;
		color: #000;
		line-height: 1.7;
	}
	.prose :global(h2) {
		font-size: 13px;
		font-weight: bold;
		margin: 16px 0 6px 0;
		padding: 2px 4px;
		background: rgb(var(--gray));
		border-left: 3px solid #0000aa;
		color: #000;
		text-transform: none;
		letter-spacing: 0;
	}
	.prose :global(h3) { font-size: 12px; font-weight: bold; margin: 12px 0 4px 0; color: #000; }
	.prose :global(p) { margin: 0 0 10px 0; }
	.prose :global(ul), .prose :global(ol) { margin: 0 0 10px 0; padding-left: 20px; }
	.prose :global(li) { margin-bottom: 4px; }
	.prose :global(img) {
		max-width: 100%;
		height: auto;
		display: block;
		margin: 12px auto;
		border: 1px solid rgb(var(--win95-shadow));
		border-radius: 0;
	}
	.prose :global(a) { color: #0000aa; }
	.prose :global(blockquote) {
		border-left: 3px solid rgb(var(--gray-dark));
		margin: 8px 0;
		padding: 4px 12px;
		background: rgb(var(--gray-light));
		font-style: italic;
	}
	.prose :global(code) {
		font-family: "Courier New", monospace;
		font-size: 11px;
		background: rgb(var(--gray-light));
		padding: 1px 4px;
		border: 1px solid rgb(var(--win95-shadow));
	}
	.prose :global(pre) {
		background: black;
		color: #00ff00;
		padding: 10px;
		font-family: "Courier New", monospace;
		font-size: 11px;
		overflow-x: auto;
		border: 1px solid rgb(var(--win95-shadow));
		border-radius: 0;
	}
	.window-statusbar {
		display: flex;
		align-items: center;
		gap: 6px;
		border-top: 1px solid rgb(var(--win95-shadow));
		padding: 2px 6px;
		font-size: 10px;
		color: rgb(var(--gray-dark));
		font-family: "MS Sans Serif", Arial, sans-serif;
		background: rgb(var(--gray));
	}
	.status-sep { color: rgb(var(--win95-shadow)); }
</style>
