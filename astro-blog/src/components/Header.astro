---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import logo from '../assets/logo.svg';

const pathname = Astro.url.pathname;
const isEnglish = pathname.startsWith('/en');
const homeLink = isEnglish ? '/en' : '/';
const blogLink = isEnglish ? '/en/blog' : '/blog';
const aboutLink = isEnglish ? '/en/about' : '/about';

const navHome = isEnglish ? 'Home' : 'Главная';
const navBlog = isEnglish ? 'Blog' : 'Блог';
const navAbout = isEnglish ? 'About' : 'О нас';
const otherLangDisplay = isEnglish ? 'РУС' : 'ENG';
const currentLangDisplay = isEnglish ? 'ENG' : 'РУС';

const getToggleLink = () => {
	if (isEnglish) {
		return pathname.replace(/^\/en/, '') || '/';
	} else {
		return `/en${pathname}`;
	}
};
const toggleLink = getToggleLink();
---

<header>
	<nav>
		<h2>
			<a href={homeLink}>
				<img src={logo.src} alt="maasdam.online logo" class="logo-icon" />
			</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href={homeLink}>{navHome}</HeaderLink>
			<HeaderLink href={blogLink}>{navBlog}</HeaderLink>
			<HeaderLink href={aboutLink}>{navAbout}</HeaderLink>
		</div>
		<div class="lang-switcher">
			<span class="lang-current">{currentLangDisplay}</span>
			<a href={toggleLink} class="lang-toggle">{otherLangDisplay}</a>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 4px;
		background: rgb(var(--gray));
		border-top: 2px solid rgb(var(--win95-highlight));
		border-left: 2px solid rgb(var(--win95-highlight));
		border-right: 2px solid rgb(var(--win95-shadow));
		border-bottom: 2px solid rgb(var(--win95-shadow));
	}
	h2 {
		margin: 0;
		font-size: 18px;
		padding: 6px 8px;
		background: transparent;
		color: rgb(0, 0, 0);
		display: flex;
		align-items: center;
		gap: 8px;
	}
	h2 a {
		display: flex;
		align-items: center;
		gap: 8px;
		text-decoration: none;
		color: rgb(255, 255, 255);
		padding: 4px 8px;
		background: transparent;
		border: 1px solid transparent;
		cursor: pointer;
	}
	h2 a:hover {
		background: rgb(var(--gray-light));
		border: 1px dashed rgb(var(--gray-dark));
	}
	.logo-icon {
		width: 64px;
		height: 64px;
		display: inline-block;
		vertical-align: middle;
	}
	.logo-text {
		font-weight: bold;
		letter-spacing: 0.5px;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 4px;
		background: rgb(var(--gray));
	}
	nav a {
		padding: 4px 8px;
		color: #0000aa;
		border: 1px solid transparent;
		text-decoration: underline;
		font-size: 12px;
		font-family: "MS Sans Serif", Arial, sans-serif;
		cursor: pointer;
	}
	nav a:hover {
		border: 1px solid rgb(var(--gray-light));
		background: rgb(var(--gray-light));
	}
	nav a.active {
		text-decoration: underline;
		color: #0000aa;
		border: 1px dashed rgb(var(--gray-dark));
		background: rgb(var(--gray-light));
	}
	.internal-links {
		display: flex;
		gap: 8px;
	}
	.lang-switcher {
		display: flex;
		gap: 4px;
		align-items: center;
		padding: 0 8px;
	}
	.lang-current {
		font-size: 12px;
		font-family: "MS Sans Serif", Arial, sans-serif;
		font-weight: bold;
		color: #0000aa;
		padding: 4px 8px;
		background: rgb(var(--gray-light));
		border: 1px solid rgb(var(--gray-dark));
	}
	.lang-toggle {
		padding: 4px 8px;
		color: #0000aa;
		border: 1px solid transparent;
		text-decoration: underline;
		font-size: 12px;
		font-family: "MS Sans Serif", Arial, sans-serif;
		cursor: pointer;
		background: rgb(var(--gray));
	}
	.lang-toggle:hover {
		border: 1px solid rgb(var(--gray-light));
		background: rgb(var(--gray-light));
	}
	@media (max-width: 720px) {
		.internal-links {
			display: none;
		}
		.lang-switcher {
			display: none;
		}
	}
</style>
