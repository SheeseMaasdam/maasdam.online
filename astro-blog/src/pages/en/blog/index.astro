---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';

const posts = (await getCollection('blog-en')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="blog-window">
				<div class="window-titlebar">
					<span>📰 Blog</span>
					<div class="window-buttons">
						<span class="win-btn">_</span>
						<span class="win-btn">□</span>
						<span class="win-btn">✕</span>
					</div>
				</div>
				<div class="window-body">
					{posts.length === 0 && (
						<p class="no-posts">No posts yet. Stay tuned!</p>
					)}
					<ul class="post-list">
						{posts.map((post) => (
							<li class="post-window">
								<div class="post-titlebar">
									<span class="post-icon">📄</span>
									<span class="post-title-text">{post.data.title}</span>
									<div class="window-buttons">
										<span class="win-btn">_</span>
										<span class="win-btn">□</span>
										<span class="win-btn">✕</span>
									</div>
								</div>
								<a href={`/en/blog/${post.id}/`} class="post-body-link">
									<div class="post-body">
										{post.data.heroImage && (
											<div class="post-image-wrap">
												<Image width={480} height={200} src={post.data.heroImage} alt={post.data.title} class="post-hero" />
											</div>
										)}
										<p class="post-desc">{post.data.description}</p>
										<p class="post-date">
											<FormattedDate date={post.data.pubDate} />
										</p>
									</div>
								</a>
								<div class="post-statusbar">
									<span>Done</span>
								</div>
							</li>
						))}
					</ul>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 760px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 1em;
	}
	.blog-window {
		background: rgb(var(--gray));
		border-top: 2px solid rgb(var(--win95-highlight));
		border-left: 2px solid rgb(var(--win95-highlight));
		border-right: 2px solid rgb(var(--win95-shadow));
		border-bottom: 2px solid rgb(var(--win95-shadow));
	}
	.window-titlebar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		background: linear-gradient(to right, #0000aa, #1084d7);
		color: white;
		padding: 3px 6px;
		font-size: 12px;
		font-weight: bold;
		font-family: "MS Sans Serif", Arial, sans-serif;
		user-select: none;
	}
	.window-buttons { display: flex; gap: 2px; }
	.win-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 16px;
		height: 14px;
		background: rgb(var(--gray));
		color: black;
		font-size: 9px;
		font-weight: bold;
		border-top: 1px solid rgb(var(--win95-highlight));
		border-left: 1px solid rgb(var(--win95-highlight));
		border-right: 1px solid rgb(var(--win95-shadow));
		border-bottom: 1px solid rgb(var(--win95-shadow));
		cursor: default;
		font-family: "MS Sans Serif", Arial, sans-serif;
	}
	.window-body { padding: 8px; background: rgb(var(--gray)); }
	.no-posts { font-size: 12px; padding: 8px; font-style: italic; }
	.post-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
	.post-window {
		background: rgb(var(--gray));
		border-top: 2px solid rgb(var(--win95-highlight));
		border-left: 2px solid rgb(var(--win95-highlight));
		border-right: 2px solid rgb(var(--win95-shadow));
		border-bottom: 2px solid rgb(var(--win95-shadow));
	}
	.post-titlebar {
		display: flex;
		align-items: center;
		gap: 6px;
		background: linear-gradient(to right, #0000aa, #1084d7);
		color: white;
		padding: 3px 6px;
		font-size: 11px;
		font-weight: bold;
		font-family: "MS Sans Serif", Arial, sans-serif;
		user-select: none;
	}
	.post-icon { font-size: 12px; }
	.post-title-text { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.post-body-link { display: block; text-decoration: none; color: inherit; }
	.post-body {
		background: white;
		padding: 8px 10px;
		border-top: 1px solid rgb(var(--win95-shadow));
		border-left: 1px solid rgb(var(--win95-shadow));
		border-right: 1px solid rgb(var(--win95-highlight));
		border-bottom: 1px solid rgb(var(--win95-highlight));
		margin: 3px;
	}
	.post-body-link:hover .post-body { background: #fffde7; }
	.post-image-wrap { margin-bottom: 8px; }
	.post-hero { width: 100%; height: 160px; object-fit: cover; border-radius: 0; border: 1px solid rgb(var(--win95-shadow)); display: block; }
	.post-desc { font-size: 12px; color: #000; margin: 0 0 6px 0; font-family: "MS Sans Serif", Arial, sans-serif; }
	.post-date { font-size: 11px; color: rgb(var(--gray-dark)); margin: 0; font-family: "MS Sans Serif", Arial, sans-serif; }
	.post-statusbar { border-top: 1px solid rgb(var(--win95-shadow)); padding: 2px 6px; font-size: 10px; color: rgb(var(--gray-dark)); font-family: "MS Sans Serif", Arial, sans-serif; background: rgb(var(--gray)); }
</style>
