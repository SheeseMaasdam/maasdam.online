---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ServerCard from '../../components/ServerCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SERVERS, DISCORD_URL } from '../../consts';
import { translations, type Language, getTranslation } from '../../i18n';

const lang = 'en' as Language;
const t = (key: keyof typeof translations.en) => getTranslation(lang, key);
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<!-- WIP Windows 95 error banner -->
		<div class="wip-banner">
			<div class="wip-titlebar">
				<span class="wip-icon">⚠️</span>
				<span class="wip-title">{t('wipTitle')}</span>
			</div>
			<div class="wip-body">
				<span class="wip-icon-big">⚠️</span>
				<span>{t('wip')}</span>
			</div>
		</div>

		<main>
			<div class="hero">
				<div class="hero-inner">
					<h1>maasdam.online</h1>
					<p>passionate public servers project</p>
				</div>
			</div>

			<section>
				<h2>🎮 {t('serverTitle')}</h2>
				<p class="game-files-notice">
					📁 {t('gameFiles')} <a href={DISCORD_URL} target="_blank" rel="noopener noreferrer">Discord</a>
				</p>
				<div class="server-cards">
					<ServerCard
						name={SERVERS.minecraft.name}
						ip={SERVERS.minecraft.ip}
						port={SERVERS.minecraft.port}
						description={SERVERS.minecraft.description}
						icon={SERVERS.minecraft.icon}
						copyBtnText={t('copyIp')}
					/>
					<ServerCard
						name={SERVERS.rimworld.name}
						ip={SERVERS.rimworld.ip}
						port={SERVERS.rimworld.port}
						description={SERVERS.rimworld.description}
						icon={SERVERS.rimworld.icon}
						copyBtnText={t('copyIp')}
					/>
				</div>
			</section>

			<section>
				<h2>📰 {t('latestNews')}</h2>
				<p>{t('checkBlog')} <a href="/en/blog">{t('blog')}</a></p>
			</section>

			<section>
				<h2>🤝 {t('joinCommunity')}</h2>
				<p>
					{t('joinDiscord')}
					<a href={DISCORD_URL} target="_blank" rel="noopener noreferrer">Discord</a>
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.wip-banner {
		margin: 8px auto;
		max-width: 480px;
		border: 2px solid;
		border-color: rgb(var(--win95-highlight)) rgb(var(--win95-shadow)) rgb(var(--win95-shadow)) rgb(var(--win95-highlight));
		background: rgb(var(--gray));
		font-family: "MS Sans Serif", Arial, sans-serif;
		font-size: 12px;
	}
	.wip-titlebar {
		display: flex;
		align-items: center;
		gap: 6px;
		background: rgb(0, 0, 128);
		color: white;
		padding: 3px 6px;
		font-weight: bold;
		font-size: 12px;
	}
	.wip-body {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 10px 14px;
		color: rgb(0, 0, 0);
		font-size: 12px;
	}
	.wip-icon-big {
		font-size: 28px;
		line-height: 1;
	}
	.game-files-notice {
		background: rgb(var(--gray-light));
		border: 1px solid rgb(var(--win95-shadow));
		padding: 6px 10px;
		font-size: 12px;
		font-family: "MS Sans Serif", Arial, sans-serif;
		margin-bottom: 10px;
		display: inline-block;
	}
</style>
